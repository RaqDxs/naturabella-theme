{{ 'nb-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  if kicker == blank
    assign kicker = 'NATURABELLA'
  endif
  if title == blank
    assign title = page.title | default: 'Nosotros'
  endif
  if lead == blank
    assign lead = 'Belleza que respeta tu piel y el planeta'
  endif
  if intro == blank
    assign intro = 'NaturaBella es una tienda arequipeña de cosmética natural. Formulamos y seleccionamos productos libres de químicos agresivos, accesibles y de calidad para toda la familia.'
  endif
  if slogan_label == blank
    assign slogan_label = 'Nuestro slogan'
  endif
  if slogan == blank
    assign slogan = 'Belleza que respeta tu piel y el planeta.'
  endif
  if who_label == blank
    assign who_label = 'Quiénes somos'
  endif
  if who_text == blank
    assign who_text = 'Somos un emprendimiento arequipeño con 11 años cuidando la piel de nuestras clientas. Creemos en una belleza más honesta, botánica y cercana.'
  endif
  if proposal_label == blank
    assign proposal_label = 'Nuestra propuesta'
  endif
  if proposal_text == blank
    assign proposal_text = 'Seleccionamos cosmética de origen natural, con ingredientes como karité, coco, cera de abejas y pigmentos frutales, y te acompañamos con una atención cercana en cada compra.'
  endif
  if mission_label == blank
    assign mission_label = 'Misión'
  endif
  if mission_text == blank
    assign mission_text = 'Ofrecer cosmética libre de químicos agresivos, accesible y de calidad para toda la familia, respetando la piel y el planeta.'
  endif
  if vision_label == blank
    assign vision_label = 'Visión'
  endif
  if vision_text == blank
    assign vision_text = 'Ser la marca de belleza natural de referencia en Arequipa y el Perú, orgullosamente local y consciente.'
  endif
-%}

<div class="nb-page nb-about">
  <div class="page-width">
    <div class="nb-about__hero">
      <div class="nb-about__copy">
        {%- if kicker != blank -%}
          <p class="nb-page__kicker">{{ kicker | escape }}</p>
        {%- endif -%}
        <h1 class="nb-page__title">{{ title | escape }}</h1>
        {%- if lead != blank -%}
          <p class="nb-about__lead">{{ lead | escape }}</p>
        {%- endif -%}
        {%- if intro != blank -%}
          <p class="nb-page__text nb-about__intro">{{ intro | escape }}</p>
        {%- endif -%}
      </div>
      <figure class="nb-about__portrait">
        {% render 'nb-photo',
          image: image_1,
          fallback: 'nb-about-portrait.jpg',
          alt: 'Ritual de cuidado botánico NaturaBella',
          img_class: 'nb-about__img',
          loading: 'eager',
          sizes: '(min-width: 750px) 42vw, 100vw'
        %}
      </figure>
    </div>
  </div>

  {%- if slogan != blank -%}
    <div class="nb-about__quote">
      <div class="page-width nb-about__quote-inner">
        {%- if slogan_label != blank -%}
          <p class="nb-page__label">{{ slogan_label | escape }}</p>
        {%- endif -%}
        <blockquote>{{ slogan | escape }}</blockquote>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="nb-about__split">
      <article class="nb-about__panel">
        {%- if who_label != blank -%}
          <p class="nb-page__label">{{ who_label | escape }}</p>
        {%- endif -%}
        <p class="nb-page__text">{{ who_text | escape }}</p>
      </article>
      <article class="nb-about__panel">
        {%- if proposal_label != blank -%}
          <p class="nb-page__label">{{ proposal_label | escape }}</p>
        {%- endif -%}
        <p class="nb-page__text">{{ proposal_text | escape }}</p>
      </article>
    </div>

    <div class="nb-about__gallery">
      <figure class="nb-about__frame nb-about__frame--tall">
        {% render 'nb-photo',
          image: image_2,
          fallback: 'hero-skincare.jpg',
          alt: 'Cuidado de la piel con luz natural',
          img_class: 'nb-about__img',
          loading: 'lazy',
          sizes: '(min-width: 750px) 50vw, 100vw'
        %}
      </figure>
      <figure class="nb-about__frame nb-about__frame--wide">
        {% render 'nb-photo',
          image: image_3,
          fallback: 'nb-about-still.jpg',
          alt: 'Ingredientes botánicos NaturaBella',
          img_class: 'nb-about__img',
          loading: 'lazy',
          sizes: '(min-width: 750px) 35vw, 100vw'
        %}
      </figure>
      <figure class="nb-about__frame nb-about__frame--wide">
        {% render 'nb-photo',
          image: image_4,
          fallback: 'nb-contact-studio.jpg',
          alt: 'Estudio de cosmética natural',
          img_class: 'nb-about__img',
          loading: 'lazy',
          sizes: '(min-width: 750px) 35vw, 100vw'
        %}
      </figure>
    </div>

    <div class="nb-about__purpose">
      <article>
        <span class="nb-about__index">01</span>
        {%- if mission_label != blank -%}
          <h2 class="nb-page__heading">{{ mission_label | escape }}</h2>
        {%- endif -%}
        <p class="nb-page__text">{{ mission_text | escape }}</p>
      </article>
      <article>
        <span class="nb-about__index">02</span>
        {%- if vision_label != blank -%}
          <h2 class="nb-page__heading">{{ vision_label | escape }}</h2>
        {%- endif -%}
        <p class="nb-page__text">{{ vision_text | escape }}</p>
      </article>
    </div>
  </div>
</div>
