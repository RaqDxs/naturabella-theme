{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="nb-trust-bar section-{{ section.id }}-padding">
  <div class="page-width">
    <ul class="nb-trust-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="nb-trust-bar__item" {{ block.shopify_attributes }}>
          <span class="nb-trust-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'bunny' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 14c-1.2-4.2-2.8-8-1.2-9.2 1.4-1 3.2 1.8 4.4 5.6"/>
                  <path d="M21 14c1.2-4.2 2.8-8 1.2-9.2-1.4-1-3.2 1.8-4.4 5.6"/>
                  <path d="M8.8 18.5c0 5 3.2 8.5 7.2 8.5s7.2-3.5 7.2-8.5c0-3.2-2.8-5.5-7.2-5.5s-7.2 2.3-7.2 5.5Z"/>
                  <circle cx="13.2" cy="18.2" r="0.8" fill="currentColor" stroke="none"/>
                  <circle cx="18.8" cy="18.2" r="0.8" fill="currentColor" stroke="none"/>
                </svg>
              {%- when 'earth' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="16" cy="16" r="10"/>
                  <path d="M6.8 16h18.4M16 6c2.6 2.8 3.8 6.4 3.8 10s-1.2 7.2-3.8 10c-2.6-2.8-3.8-6.4-3.8-10s1.2-7.2 3.8-10Z"/>
                  <path d="M8.6 11.2c2.2.6 4.6.8 7.4.4M23.4 20.6c-2.4-.4-5-.4-7.8.2"/>
                </svg>
              {%- when 'drop' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 5c0 0 8 9.2 8 14.4A8 8 0 1 1 8 19.4C8 14.2 16 5 16 5Z"/>
                  <path d="M13 20.5c.8 1.6 2.4 2.4 4.2 2.2"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 24c8-1 16-8 18-18-10 2-17 10-18 18Z"/>
                  <path d="M8 24c4-4 9-8 16-10"/>
                </svg>
            {%- endcase -%}
          </span>
          <p class="nb-trust-bar__label">{{ block.settings.title | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .nb-trust-bar {
    background: transparent;
  }

  .nb-trust-bar__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4rem 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nb-trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .nb-trust-bar__icon {
    width: 4.4rem;
    height: 4.4rem;
    display: grid;
    place-items: center;
    color: rgb(var(--nb-primary-rgb, 163, 144, 228));
  }

  .nb-trust-bar__icon svg {
    width: 2.8rem;
    height: 2.8rem;
  }

  .nb-trust-bar__label {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--nb-text-rgb, 45, 45, 45));
  }

  @media screen and (min-width: 750px) {
    .nb-trust-bar__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barra de confianza",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Superior",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Inferior",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Indicador",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "leaf", "label": "Hoja" },
            { "value": "bunny", "label": "Conejo" },
            { "value": "earth", "label": "Tierra" },
            { "value": "drop", "label": "Gota" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texto",
          "default": "100% Natural"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de confianza",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "leaf",
            "title": "100% Natural"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "bunny",
            "title": "Libre de crueldad"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "earth",
            "title": "Empaques eco-amigables"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "drop",
            "title": "Libre de químicos agresivos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
