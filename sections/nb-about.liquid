{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {% render 'nb-about',
    kicker: section.settings.kicker,
    title: section.settings.title,
    lead: section.settings.lead,
    intro: section.settings.intro,
    slogan_label: section.settings.slogan_label,
    slogan: section.settings.slogan,
    who_label: section.settings.who_label,
    who_text: section.settings.who_text,
    proposal_label: section.settings.proposal_label,
    proposal_text: section.settings.proposal_text,
    mission_label: section.settings.mission_label,
    mission_text: section.settings.mission_text,
    vision_label: section.settings.vision_label,
    vision_text: section.settings.vision_text,
    image_1: section.settings.image_1,
    image_2: section.settings.image_2,
    image_3: section.settings.image_3,
    image_4: section.settings.image_4
  %}
</div>

{% schema %}
{
  "name": "Nosotros editorial",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Etiqueta",
      "default": "NATURABELLA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nosotros"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Frase principal",
      "default": "Belleza que respeta tu piel y el planeta"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción",
      "default": "NaturaBella es una tienda arequipeña de cosmética natural. Formulamos y seleccionamos productos libres de químicos agresivos, accesibles y de calidad para toda la familia."
    },
    {
      "type": "header",
      "content": "Slogan"
    },
    {
      "type": "text",
      "id": "slogan_label",
      "label": "Título del slogan",
      "default": "Nuestro slogan"
    },
    {
      "type": "textarea",
      "id": "slogan",
      "label": "Slogan",
      "default": "Belleza que respeta tu piel y el planeta."
    },
    {
      "type": "header",
      "content": "Quiénes somos"
    },
    {
      "type": "text",
      "id": "who_label",
      "label": "Título",
      "default": "Quiénes somos"
    },
    {
      "type": "textarea",
      "id": "who_text",
      "label": "Texto",
      "default": "Somos un emprendimiento arequipeño con 11 años cuidando la piel de nuestras clientas. Creemos en una belleza más honesta, botánica y cercana."
    },
    {
      "type": "text",
      "id": "proposal_label",
      "label": "Título propuesta",
      "default": "Nuestra propuesta"
    },
    {
      "type": "textarea",
      "id": "proposal_text",
      "label": "Texto propuesta",
      "default": "Seleccionamos cosmética de origen natural, con ingredientes como karité, coco, cera de abejas y pigmentos frutales, y te acompañamos con una atención cercana en cada compra."
    },
    {
      "type": "header",
      "content": "Misión y visión"
    },
    {
      "type": "text",
      "id": "mission_label",
      "label": "Título misión",
      "default": "Misión"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Misión",
      "default": "Ofrecer cosmética libre de químicos agresivos, accesible y de calidad para toda la familia, respetando la piel y el planeta."
    },
    {
      "type": "text",
      "id": "vision_label",
      "label": "Título visión",
      "default": "Visión"
    },
    {
      "type": "textarea",
      "id": "vision_text",
      "label": "Visión",
      "default": "Ser la marca de belleza natural de referencia en Arequipa y el Perú, orgullosamente local y consciente."
    },
    {
      "type": "header",
      "content": "Imágenes"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Retrato principal"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Galería grande"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Galería superior"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Galería inferior"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Superior",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Inferior",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Nosotros editorial"
    }
  ]
}
{% endschema %}
