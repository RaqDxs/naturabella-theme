{% doc %}
  @prompt
    seccion de pagos
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-payment-section-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-payment-section-{{ ai_gen_id }}__description {
    max-width: 650px;
    margin: 0 auto 18px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-payment-section-{{ ai_gen_id }}__methods {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-payment-section-{{ ai_gen_id }}__method {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 54px;
    height: 34px;
    padding: 5px 8px;
    background: {{ block.settings.card_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-payment-section-{{ ai_gen_id }}__method svg {
    width: auto;
    max-width: 48px;
    height: 24px;
  }

  .ai-payment-section-{{ ai_gen_id }}__secure {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    color: {{ block.settings.text_color }};
    font-size: 12px;
    line-height: 1.4;
  }

  .ai-payment-section-{{ ai_gen_id }}__secure svg {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    color: {{ block.settings.heading_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-payment-section-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px 16px;
    }

    .ai-payment-section-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-payment-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-payment-section-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-payment-section-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>
  {% endif %}

  {% if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
    <ul class="ai-payment-section-{{ ai_gen_id }}__methods" aria-label="Métodos de pago aceptados">
      {% for type in shop.enabled_payment_types %}
        <li class="ai-payment-section-{{ ai_gen_id }}__method">
          {{ type | payment_type_svg_tag: class: 'ai-payment-icon' }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if block.settings.show_secure_message %}
    <div class="ai-payment-section-{{ ai_gen_id }}__secure">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="2"></rect>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
      </svg>
      <span>{{ block.settings.secure_message | escape }}</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Sección de pagos",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Paga de forma segura"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Aceptamos diferentes métodos de pago para que compres con tranquilidad.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar métodos disponibles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secure_message",
      "label": "Mostrar mensaje de seguridad",
      "default": true
    },
    {
      "type": "text",
      "id": "secure_message",
      "label": "Mensaje de seguridad",
      "default": "Pago protegido y seguro"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente del título",
      "default": "playfair_display_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Espaciado vertical",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Espaciado horizontal",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio exterior",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de los métodos",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "default": "#F8F8FA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Título e icono",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Fondo de método",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Borde de método",
      "default": "#DDD8EA"
    }
  ],
  "presets": [
    {
      "name": "Sección de pagos"
    }
  ],
  "tag": null,
  "class": "payment-section-block"
}
{% endschema %}